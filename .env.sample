# API Settings
SERVER_HOST=0.0.0.0
API_PORT=8000
WEBUI_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SERVER_MODE=production
LOG_LEVEL=INFO
TEMP_PATH=/app/tmp
ROOT_PATH=

DB_PATH=./data/translator.db

# LLM Configuration (LiteLLM)
LLM_HOST=your-llm-host
LLM_PORT=80
LLM_SECURE=false
LLM_API_KEY=your-api-key
LLM_TRANSLATE_MODEL=your-translation-model
LLM_JUDGE_MODEL=your-judge-model
LLM_COOLDOWN=300

# Translation Core Settings
TRANSLATE_CHUNK_MAX_CHARS=1000
TRANSLATE_SMALLEST_CHUNK=300
TRANSLATE_MAX_REVIEW_CYCLE=5
TRANSLATE_THRESHOLD_SCORE=80
TRANSLATE_SMALL_CHUNK_SCORE=70
TRANSLATE_SMALL_CHUNK_SIZE=300
